# ============================================
# ops-ai-agent — variaveis de ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================

# --------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# --------------------------------------------
# Usuario do banco criado pelo Docker
POSTGRES_USER=ops
# Senha do banco — altere em producao
POSTGRES_PASSWORD=ops123
# Nome do banco da API (separado do banco do n8n)
POSTGRES_DB=ops_api
# String de conexao usada pelo Prisma
DATABASE_URL=postgresql://ops:ops123@localhost:5433/ops_api

# --------------------------------------------
# API (Node.js / Express)
# --------------------------------------------
# Porta da API REST
PORT=3001
# Chave secreta para assinar tokens JWT — use uma string longa e aleatoria em producao
JWT_SECRET=troque-por-uma-chave-secreta-longa-em-producao

# --------------------------------------------
# GOOGLE GEMINI (IA)
# --------------------------------------------
# Chave da API do Google Gemini — obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-do-gemini-aqui

# --------------------------------------------
# WAHA (WhatsApp HTTP API)
# --------------------------------------------
# Chave de autenticacao do WAHA — deve ser igual ao valor no docker-compose.yml
WAHA_API_KEY=waha-api-key-123

# --------------------------------------------
# FRONTEND (Next.js)
# --------------------------------------------
# URL da API acessada pelo browser — nao altere em desenvolvimento local
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL do frontend — usada pelo CORS da API
FRONTEND_URL=http://localhost:3000

# --------------------------------------------
# n8n (Automacao de workflows)
# --------------------------------------------
# Host do n8n
N8N_HOST=localhost
# URL base do n8n para webhooks
N8N_WEBHOOK_URL=http://localhost:5678

# --------------------------------------------
# META WHATSAPP BUSINESS API (opcional)
# --------------------------------------------
# Token de acesso da Meta — obtido no painel developers.facebook.com
META_ACCESS_TOKEN=seu-token-da-meta-aqui
# ID do numero de telefone do WhatsApp Business
META_PHONE_NUMBER_ID=seu-phone-number-id
# ID da conta WhatsApp Business
META_WABA_ID=seu-waba-id
# --------------------------------------------
# OPENCLAW (Gateway de agentes de IA)
# --------------------------------------------
# Senha de acesso ao gateway OpenClaw
OPENCLAW_GATEWAY_PASSWORD=troque-por-senha-segura-em-producao
# Porta do gateway OpenClaw
OPENCLAW_PORT=18789
