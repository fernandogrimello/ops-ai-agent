{
  "preset": "ts-jest",
  "testEnvironment": "jsdom",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1"
  },
  "testMatch": [
    "**/__tests__/**/*.test.tsx",
    "**/__tests__/**/*.test.ts"
  ],
  "transform": {
    "^.+\\.(ts|tsx)$": [
      "ts-jest",
      {
        "tsconfig": {
          "jsx": "react-jsx"
        }
      }
    ]
  },
  "setupFilesAfterEnv": [
    "@testing-library/jest-dom"
  ]
}